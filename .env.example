# Get a free key at https://aistudio.google.com/apikey and paste it below, then rename this file to .env
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# seconds between calls (free tier is rate limited; lower it on a paid key)
GEMINI_MIN_INTERVAL=4.5
FORGE_MAX_CALLS=400
